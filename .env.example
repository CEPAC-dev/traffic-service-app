# Copy this file to .env and replace the placeholders locally. Never commit .env.
SECRET_KEY=generate-a-random-secret-for-local-use
OUTSCRAPER_API_KEY=your-outscraper-api-key
# Password for the first-run admin account (admin@demo.com). If empty, a random one is printed once at first start.
TRAFFICLENS_ADMIN_PASSWORD=
# Upkeep (all optional). Backups go to ./backups unless TRAFFICLENS_BACKUP_DIR is set.
TRAFFICLENS_BACKUP_EVERY_HOURS=24
TRAFFICLENS_BACKUP_KEEP=7
TRAFFICLENS_BACKUP_DIR=
# Delete MATLAB run workbooks that are older than this many days and no longer referenced (0 = never).
VOLUME_RUN_RETENTION_DAYS=30
# Set to 0 to stop the built-in scheduler (for example when you run backup.py from Task Scheduler instead).
TRAFFICLENS_MAINTENANCE=1
