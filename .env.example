# Copy this file to .env and replace the placeholders locally. Never commit .env.
SECRET_KEY=generate-a-random-secret-for-local-use
OUTSCRAPER_API_KEY=your-outscraper-api-key
# Password for the first-run admin account (admin@demo.com). If empty, a random one is printed once at first start.
TRAFFICLENS_ADMIN_PASSWORD=
